[run]
branch = True
source = cotizador
omit =
    cotizador/migrations/*
    cotizador/test*.py
    cotizador/admin.py
    cotizador/apps.py
    cotizador/signals.py

[report]
show_missing = True
skip_covered = True
fail_under = 80
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
