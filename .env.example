# Copie este archivo como .env en la raíz del proyecto (nunca lo suba a Git).
DJANGO_SECRET_KEY=GENERAR_UNA_CLAVE_SEGURA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=
TOKEN_EXPIRATION_HOURS=8
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/cintac_cotizador

# Opcionales (valores por defecto entre paréntesis)
# LOGIN_MAX_FALLOS=10            (intentos fallidos antes de bloquear la cuenta)
# LOGIN_BLOQUEO_SEGUNDOS=900     (duración del bloqueo)
# TIPO_CAMBIO_REINTENTO_SEGUNDOS=300 (espera antes de reintentar la fuente del dólar)
# CINTAC_LOG_LEVEL=INFO
